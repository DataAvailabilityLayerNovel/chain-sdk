# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
#
# Auth token bắt buộc khi profile=prod để chặn POST không xác thực.
# Tạo nhanh:  openssl rand -hex 32
COSMOS_EXEC_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# Origin frontend được phép gọi. Đừng để "*" trên prod.
COSMOS_EXEC_CORS_ORIGIN=https://app.mychain.io

# Faucet (tuỳ chọn). Bỏ comment để bật — chỉ dùng cho devnet/testnet.
# Tạo nhanh:  openssl rand -hex 32
# COSMOS_EXEC_TREASURY_PRIVKEY_HEX=

# Địa chỉ nhận phí gom được mỗi block. Bỏ trống = phí ở lại fee_collector.
# QUAN TRỌNG: mọi node (sequencer + full node) PHẢI set giá trị giống nhau,
# nếu lệch sẽ fork state. Không dùng địa chỉ module account.
# COSMOS_EXEC_TREASURY_ADDR=cosmos1...
